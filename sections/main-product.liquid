{% assign current_variant = product.selected_or_first_available_variant %}
<section class="product-page section-pad" data-product-section>
<div class="product-gallery">{% for media in product.media %}<div class="product-media" id="Media-{{ media.id }}">{% case media.media_type %}{% when 'image' %}{{ media | image_url: width: 1600 | image_tag: loading: 'lazy', widths: '600,900,1200,1600', sizes: '(min-width: 900px) 55vw, 100vw' }}{% when 'video' %}{{ media | video_tag: controls: true, preload: 'metadata', image_size: '1000x' }}{% when 'external_video' %}{{ media | external_video_tag }}{% when 'model' %}{{ media | model_viewer_tag }}{% endcase %}</div>{% else %}{{ 'product-1' | placeholder_svg_tag: 'placeholder-svg' }}{% endfor %}</div>
<div class="product-details"><p class="eyebrow">{{ product.vendor | escape }} / {{ product.type | escape }}</p><h1>{{ product.title | escape }}</h1><div class="product-price" aria-live="polite"><span data-price>{{ current_variant.price | money }}</span> <s data-compare {% unless current_variant.compare_at_price > current_variant.price %}hidden{% endunless %}>{{ current_variant.compare_at_price | money }}</s></div>
{% assign product_form_id = 'ProductForm-' | append: section.id %}{% form 'product', product, id: product_form_id %}{{ form.errors | default_errors }}
<label for="Variant-{{ section.id }}">{{ 'products.options' | t }}</label><select name="id" id="Variant-{{ section.id }}" data-variant-select>{% for variant in product.variants %}<option value="{{ variant.id }}" {% if variant.id == current_variant.id %}selected{% endif %}>{{ variant.title | escape }} — {{ variant.price | money }}{% unless variant.available %} — {{ 'products.sold_out' | t }}{% endunless %}</option>{% endfor %}</select>
<label for="Quantity-{{ section.id }}">{{ 'products.quantity' | t }}</label><input id="Quantity-{{ section.id }}" type="number" name="quantity" min="{{ current_variant.quantity_rule.min }}" step="{{ current_variant.quantity_rule.increment }}" value="{{ current_variant.quantity_rule.min }}" {% if current_variant.quantity_rule.max %}max="{{ current_variant.quantity_rule.max }}"{% endif %} data-quantity>
<button type="submit" name="add" class="button product-add" data-add data-available-text="{{ 'products.add' | t }}" data-unavailable-text="{{ 'products.sold_out' | t }}" {% unless current_variant.available %}disabled{% endunless %}><span data-add-label>{% if current_variant.available %}{{ 'products.add' | t }}{% else %}{{ 'products.sold_out' | t }}{% endif %}</span>{% render 'icon', name: 'arrow' %}</button>
{% endform %}
<div class="product-description rte">{{ product.description }}</div>
{% if section.settings.size_guide != blank %}<details class="detail-row"><summary>{{ 'products.size_guide' | t }}</summary><div class="rte">{{ section.settings.size_guide.content }}</div></details>{% endif %}
{% if product.metafields.custom.fabric_care != blank %}<details class="detail-row"><summary>{{ 'products.care' | t }}</summary>{{ product.metafields.custom.fabric_care | metafield_tag }}</details>{% endif %}
{% for block in section.blocks %}{% case block.type %}{% when '@app' %}{% render block %}{% when 'detail' %}<details class="detail-row" {{ block.shopify_attributes }}><summary>{{ block.settings.title | escape }}</summary><div class="rte">{{ block.settings.content }}</div></details>{% endcase %}{% endfor %}
</div><script type="application/json" data-variants>[{% for variant in product.variants %}{"id":{{ variant.id | json }},"available":{{ variant.available | json }},"price":{{ variant.price | money | json }},"compare":{% if variant.compare_at_price > variant.price %}{{ variant.compare_at_price | money | json }}{% else %}null{% endif %},"media":{% if variant.featured_media %}{{ variant.featured_media.id | json }}{% else %}null{% endif %},"min":{{ variant.quantity_rule.min | json }},"max":{{ variant.quantity_rule.max | json }},"step":{{ variant.quantity_rule.increment | json }}}{% unless forloop.last %},{% endunless %}{% endfor %}]</script></section>
<script type="application/ld+json">{{ product | structured_data }}</script>

{% schema %}
{"name": "Product", "settings": [{"type": "page", "id": "size_guide", "label": "Size guide page"}], "blocks": [{"type": "@app"}, {"type": "detail", "name": "Detail accordion", "settings": [{"type": "text", "id": "title", "label": "Title", "default": "Details"}, {"type": "richtext", "id": "content", "label": "Content"}]}]}
{% endschema %}
