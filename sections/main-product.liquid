{% assign current_variant = product.selected_or_first_available_variant %}
{% assign product_form_id = 'ProductForm-' | append: section.id %}
{% assign has_size_guide = false %}{% if section.settings.size_guide != blank %}{% assign has_size_guide = true %}{% endif %}
<section class="product-page section-pad" data-product-section>
<div class="product-gallery" data-gallery>
<div class="gallery-track" data-gallery-track>{% for media in product.media %}<div class="product-media{% if forloop.first %} is-lead{% endif %}" id="Media-{{ section.id }}-{{ media.id }}" data-gallery-slide>{% case media.media_type %}{% when 'image' %}{%- capture media_alt -%}{{ media.alt | default: product.title | escape }}{%- endcapture -%}<button type="button" class="media-zoom" data-zoom-src="{{ media | image_url: width: 2400 }}" data-zoom-alt="{{ media_alt }}" aria-label="{{ 'products.zoom' | t }}: {{ media_alt }}">{% if forloop.first %}{{ media | image_url: width: 1600 | image_tag: loading: 'eager', fetchpriority: 'high', widths: '600,900,1200,1600', sizes: '(min-width: 900px) 55vw, 100vw', alt: media_alt }}{% else %}{{ media | image_url: width: 1600 | image_tag: loading: 'lazy', widths: '600,900,1200,1600', sizes: '(min-width: 900px) 28vw, 100vw', alt: media_alt }}{% endif %}<span class="media-zoom-hint" aria-hidden="true">{% render 'icon', name: 'zoom' %}</span></button>{% when 'video' %}{{ media | video_tag: controls: true, preload: 'metadata', image_size: '1000x' }}{% when 'external_video' %}{{ media | external_video_tag }}{% when 'model' %}{{ media | model_viewer_tag }}{% endcase %}</div>{% else %}<div class="product-media is-lead">{{ 'product-1' | placeholder_svg_tag: 'placeholder-svg' }}</div>{% endfor %}</div>
{% if product.media.size > 1 %}<div class="gallery-dots" aria-hidden="true">{% for media in product.media %}<span{% if forloop.first %} class="is-active"{% endif %}></span>{% endfor %}</div><p class="gallery-count" aria-hidden="true"><span data-gallery-current>1</span> / {{ product.media.size }}</p>{% endif %}
</div>
<div class="product-details"><p class="eyebrow">{{ product.vendor | escape }}{% if product.type != blank %} / {{ product.type | escape }}{% endif %}</p><h1>{{ product.title | escape }}</h1><div class="product-price" aria-live="polite"><span data-price>{{ current_variant.price | money }}</span> <s data-compare {% unless current_variant.compare_at_price > current_variant.price %}hidden{% endunless %}>{{ current_variant.compare_at_price | money }}</s></div>
{%- assign fit_note = product.metafields.custom.fit.value -%}{%- assign model_note = product.metafields.custom.model_info.value -%}
{% if fit_note != blank or model_note != blank %}<ul class="product-facts">{% if fit_note != blank %}<li><span>{{ 'products.fit' | t }}</span>{{ fit_note | escape }}</li>{% endif %}{% if model_note != blank %}<li><span>{{ 'products.model' | t }}</span>{{ model_note | escape }}</li>{% endif %}</ul>{% endif %}
{% form 'product', product, id: product_form_id, class: 'product-form', data-product-form: '' %}{{ form.errors | default_errors }}
{% render 'variant-picker', product: product, section_id: section.id, size_guide: has_size_guide %}
<div class="variant-fallback{% if product.has_only_default_variant %} is-single{% endif %}"><label for="Variant-{{ section.id }}">{{ 'products.options' | t }}</label><select name="id" id="Variant-{{ section.id }}" data-variant-select>{% for variant in product.variants %}<option value="{{ variant.id }}" {% if variant.id == current_variant.id %}selected{% endif %}>{{ variant.title | escape }} — {{ variant.price | money }}{% unless variant.available %} — {{ 'products.sold_out' | t }}{% endunless %}</option>{% endfor %}</select></div>
<label for="Quantity-{{ section.id }}">{{ 'products.quantity' | t }}</label>
<div class="qty-stepper"><button type="button" class="qty-btn" data-qty-step="-1" aria-label="{{ 'products.decrease' | t }}">{% render 'icon', name: 'minus' %}</button><input id="Quantity-{{ section.id }}" type="number" name="quantity" min="{{ current_variant.quantity_rule.min }}" step="{{ current_variant.quantity_rule.increment }}" value="{{ current_variant.quantity_rule.min }}" {% if current_variant.quantity_rule.max %}max="{{ current_variant.quantity_rule.max }}"{% endif %} data-quantity><button type="button" class="qty-btn" data-qty-step="1" aria-label="{{ 'products.increase' | t }}">{% render 'icon', name: 'plus' %}</button></div>
<button type="submit" name="add" class="button product-add" data-add data-available-text="{{ 'products.add' | t }}" data-unavailable-text="{{ 'products.sold_out' | t }}" data-adding-text="{{ 'products.adding' | t }}" {% unless current_variant.available %}disabled{% endunless %}><span data-add-label>{% if current_variant.available %}{{ 'products.add' | t }}{% else %}{{ 'products.sold_out' | t }}{% endif %}</span>{% render 'icon', name: 'arrow' %}</button>
<p class="form-error" role="alert" data-form-error hidden></p>
{% endform %}
<div class="product-trust"><p>{% render 'icon', name: 'lock' %}<span>{{ 'products.secure_checkout' | t }}</span></p>{% if shop.enabled_payment_types.size > 0 %}<ul class="payment-icons" aria-label="{{ 'products.payment_methods' | t }}">{% for type in shop.enabled_payment_types %}<li>{{ type | payment_type_svg_tag }}</li>{% endfor %}</ul>{% endif %}</div>
<div class="product-accordions">
{% if product.description != blank %}<details class="detail-row" open><summary>{{ 'products.details' | t }}</summary><div class="product-description rte">{{ product.description }}</div></details>{% endif %}
{% if has_size_guide %}<details class="detail-row"><summary>{{ 'products.size_guide' | t }}</summary><div class="rte">{{ section.settings.size_guide.content }}</div></details>{% endif %}
{% if product.metafields.custom.fabric_care != blank %}<details class="detail-row"><summary>{{ 'products.care' | t }}</summary>{{ product.metafields.custom.fabric_care | metafield_tag }}</details>{% endif %}
{% for block in section.blocks %}{% case block.type %}{% when '@app' %}{% render block %}{% when 'detail' %}<details class="detail-row" {{ block.shopify_attributes }}><summary>{{ block.settings.title | escape }}</summary><div class="rte">{{ block.settings.content }}</div></details>{% endcase %}{% endfor %}
{% if shop.shipping_policy.body != blank %}<details class="detail-row"><summary>{% render 'icon', name: 'truck' %}{{ 'products.shipping' | t }}</summary><div class="rte"><p>{{ shop.shipping_policy.body | strip_html | truncatewords: 45 }}</p><a class="text-link" href="{{ shop.shipping_policy.url }}">{{ 'products.read_policy' | t }} {% render 'icon', name: 'arrow' %}</a></div></details>{% endif %}
{% if shop.refund_policy.body != blank %}<details class="detail-row"><summary>{% render 'icon', name: 'return' %}{{ 'products.returns' | t }}</summary><div class="rte"><p>{{ shop.refund_policy.body | strip_html | truncatewords: 45 }}</p><a class="text-link" href="{{ shop.refund_policy.url }}">{{ 'products.read_policy' | t }} {% render 'icon', name: 'arrow' %}</a></div></details>{% endif %}
</div>
</div>
<div class="sticky-atc" data-sticky-atc aria-hidden="true"><div class="sticky-atc-info"><span class="sticky-atc-title">{{ product.title | escape }}</span><span class="sticky-atc-meta"><span data-sticky-variant>{% unless product.has_only_default_variant %}{{ current_variant.title | escape }}{% endunless %}</span> <span data-sticky-price>{{ current_variant.price | money }}</span></span></div><button type="submit" form="{{ product_form_id }}" class="button" data-sticky-add tabindex="-1" {% unless current_variant.available %}disabled{% endunless %}><span data-add-label>{% if current_variant.available %}{{ 'products.add' | t }}{% else %}{{ 'products.sold_out' | t }}{% endif %}</span></button></div>
{% if has_size_guide %}<dialog class="size-guide-dialog" data-size-guide aria-labelledby="SizeGuideTitle-{{ section.id }}"><div class="dialog-head"><h2 id="SizeGuideTitle-{{ section.id }}">{{ section.settings.size_guide.title | escape }}</h2><button type="button" class="icon-button" data-dialog-close aria-label="{{ 'general.close' | t }}">{% render 'icon', name: 'close' %}</button></div><div class="rte">{{ section.settings.size_guide.content }}</div></dialog>{% endif %}
<dialog class="zoom-dialog" data-zoom-dialog aria-label="{{ 'products.zoom' | t }}"><button type="button" class="icon-button zoom-close" data-zoom-close aria-label="{{ 'general.close' | t }}">{% render 'icon', name: 'close' %}</button><img data-zoom-img alt="" width="1200" height="1500"></dialog>
<script type="application/json" data-variants>[{% for variant in product.variants %}{"id":{{ variant.id | json }},"title":{{ variant.title | json }},"options":{{ variant.options | json }},"available":{{ variant.available | json }},"price":{{ variant.price | money | json }},"compare":{% if variant.compare_at_price > variant.price %}{{ variant.compare_at_price | money | json }}{% else %}null{% endif %},"media":{% if variant.featured_media %}{{ variant.featured_media.id | json }}{% else %}null{% endif %},"min":{{ variant.quantity_rule.min | json }},"max":{{ variant.quantity_rule.max | json }},"step":{{ variant.quantity_rule.increment | json }}}{% unless forloop.last %},{% endunless %}{% endfor %}]</script></section>
<script type="application/ld+json">{{ product | structured_data }}</script>

{% schema %}
{"name": "Product", "settings": [{"type": "page", "id": "size_guide", "label": "Size guide page"}], "blocks": [{"type": "@app"}, {"type": "detail", "name": "Detail accordion", "settings": [{"type": "text", "id": "title", "label": "Title", "default": "Details"}, {"type": "richtext", "id": "content", "label": "Content"}]}]}
{% endschema %}
