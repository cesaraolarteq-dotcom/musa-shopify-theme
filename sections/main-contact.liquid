<section class="section-pad prose-page"><p class="eyebrow">{{ 'general.contact' | t }}</p><h1>{{ page.title | escape }}</h1><div class="rte">{{ page.content }}</div>{% form 'contact' %}{% if form.posted_successfully? %}<p role="status">{{ 'contact.success' | t }}</p>{% endif %}{{ form.errors | default_errors }}<label for="ContactName">{{ 'contact.name' | t }}</label><input id="ContactName" name="contact[name]" type="text" autocomplete="name" required><label for="ContactEmail">{{ 'club.email' | t }}</label><input id="ContactEmail" name="contact[email]" type="email" autocomplete="email" required><label for="ContactMessage">{{ 'contact.message' | t }}</label><textarea id="ContactMessage" name="contact[body]" rows="6" required></textarea><button class="button" type="submit">{{ 'contact.send' | t }} {% render 'icon', name: 'arrow' %}</button>{% endform %}</section>

{% schema %}
{"name": "Contact", "settings": []}
{% endschema %}
