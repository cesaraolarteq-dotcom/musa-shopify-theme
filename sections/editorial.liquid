<section class="editorial{% if section.settings.scheme == 'dark' %} editorial--dark{% endif %}"><div class="editorial-art">{% if section.settings.image %}{{ section.settings.image | image_url: width: 1400 | image_tag: loading: 'lazy', widths: '600,900,1400', sizes: '(min-width: 900px) 50vw, 100vw' }}{% else %}<div class="brand-art brand-art--dark" aria-hidden="true">{% render 'organic-waves', tone: 'dark' %}<div class="brand-art-mark"><img src="{{ 'logo-ivory.svg' | asset_url }}" width="360" height="85" alt="" loading="lazy"><span>@hellomusa.us</span></div></div>{% endif %}<span class="editorial-image-label">MUSA / {{ 'editorial.image_label' | t }}</span></div><div class="editorial-copy"><p class="eyebrow">{{ 'editorial.eyebrow' | t }}</p><h2>{{ 'editorial.first' | t }}<br><em>{{ 'editorial.emphasis' | t }}</em></h2><p>{{ 'editorial.description' | t }}</p><a class="text-link" href="{% if section.settings.link %}{{ section.settings.link }}{% else %}{{ routes.all_products_collection_url }}{% endif %}">{{ 'editorial.cta' | t }} {% render 'icon', name: 'arrow' %}</a><div class="editorial-number" aria-hidden="true">02</div></div></section>

{% schema %}
{"name": "MUSA Movement story", "settings": [{"type": "image_picker", "id": "image", "label": "Editorial image"}, {"type": "url", "id": "link", "label": "Story destination"}, {"type": "select", "id": "scheme", "label": "Colour scheme", "options": [{"value": "dark", "label": "Dark (espresso night)"}, {"value": "light", "label": "Light"}], "default": "dark"}], "presets": [{"name": "MUSA Movement story"}]}
{% endschema %}
