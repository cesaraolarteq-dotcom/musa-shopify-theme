{% assign featured = section.settings.collection %}
{% assign featured_count = featured.products | size %}
<section class="section-pad featured" id="the-edit"><div class="section-heading"><div><p class="eyebrow">{{ 'featured.eyebrow' | t }}</p><h2>{% if section.settings.heading != blank %}{{ section.settings.heading | escape }}{% else %}{{ 'featured.title' | t }} <em>{{ 'featured.emphasis' | t }}</em>{% endif %}</h2></div><a class="text-link" href="{% if featured != blank %}{{ featured.url }}{% else %}{{ routes.all_products_collection_url }}{% endif %}">{{ 'featured.all' | t }} {% render 'icon', name: 'arrow' %}</a></div>
<div class="product-grid">{% if featured_count > 0 %}{% for product in featured.products limit: section.settings.limit %}{% render 'product-card', product: product %}{% endfor %}{% elsif section.settings.show_demo %}{% for i in (1..4) %}{% render 'demo-card', index: i %}{% endfor %}{% else %}<p class="empty-message">{{ 'featured.empty' | t }}</p>{% endif %}</div>
{% if featured_count == 0 and section.settings.show_demo %}<p class="demo-disclaimer">{{ 'demo.disclaimer' | t }}</p>{% endif %}</section>

{% schema %}
{"name": "MUSA Collection edit", "settings": [{"type": "collection", "id": "collection", "label": "Featured collection"}, {"type": "text", "id": "heading", "label": "Custom heading (optional)"}, {"type": "range", "id": "limit", "label": "Products", "min": 4, "max": 12, "step": 4, "default": 4}, {"type": "checkbox", "id": "show_demo", "label": "Show concept garments when empty", "default": true}], "presets": [{"name": "MUSA Collection edit"}]}
{% endschema %}
