<section class="club section-pad{% if section.settings.scheme == 'dark' %} club--dark{% endif %}"><div><p class="eyebrow">{{ 'club.eyebrow' | t }}</p><h2>{{ 'club.first' | t }}<br><em>{{ 'club.emphasis' | t }}</em></h2><p>{{ 'club.description' | t }}</p>{% if settings.club_page != blank and page.id != settings.club_page.id %}<a class="text-link club-page-link" href="{{ settings.club_page.url }}">{{ 'events.explore' | t }}</a>{% endif %}</div><div class="club-form">{% assign newsletter_id = 'MusaNewsletter-' | append: section.id %}{% form 'customer', id: newsletter_id %}<input type="hidden" name="contact[tags]" value="newsletter,musa-club">
{% if form.posted_successfully? %}<p class="form-success" role="status">{{ 'club.success' | t }}</p>{% else %}{{ form.errors | default_errors }}<label for="NewsletterEmail-{{ section.id }}">{{ 'club.email' | t }}</label><div class="newsletter-row"><input id="NewsletterEmail-{{ section.id }}" type="email" name="contact[email]" autocomplete="email" placeholder="{{ 'club.placeholder' | t }}" required><button type="submit" aria-label="{{ 'club.join' | t }}">{% render 'icon', name: 'arrow' %}</button></div><label class="consent"><input type="checkbox" name="contact[accepts_marketing]" value="true" required><span>{{ 'club.consent' | t }}{% if shop.privacy_policy != blank %} <a href="{{ shop.privacy_policy.url }}">{{ 'club.privacy' | t }}</a>{% endif %}</span></label>{% endif %}{% endform %}<span class="club-footnote">{{ 'club.footnote' | t }}</span></div></section>

{% schema %}
{"name": "MUSA Club", "settings": [{"type": "select", "id": "scheme", "label": "Colour scheme", "options": [{"value": "light", "label": "Light"}, {"value": "dark", "label": "Dark (espresso night)"}], "default": "light"}], "presets": [{"name": "MUSA Club"}]}
{% endschema %}
