<div class="announcement"><span>{{ 'brand.announcement' | t }}</span><span class="announcement-right">MUSA / EST. 2026</span></div>
<header class="site-header">
  <button class="menu-toggle icon-button" type="button" aria-expanded="false" aria-controls="MobileMenu" aria-label="{{ 'general.menu' | t }}">{% render 'icon', name: 'menu' %}</button>
  <nav class="desktop-nav" aria-label="{{ 'general.navigation' | t }}">
    {% if section.settings.menu != blank %}{% for link in section.settings.menu.links %}
      {% if link.links != blank %}{%- assign mega = false -%}{%- for child in link.links -%}{%- if child.type == 'collection_link' -%}{%- assign child_img = child.object.image | default: child.object.featured_image -%}{%- if child_img != blank -%}{%- assign mega = true -%}{%- endif -%}{%- endif -%}{%- endfor -%}<details class="nav-dropdown{% if mega %} nav-dropdown--mega{% endif %}"><summary>{{ link.title | escape }}</summary><div class="nav-submenu{% if mega %} nav-mega{% endif %}">{% for child in link.links %}<a href="{{ child.url }}">{% if mega %}{%- assign child_img = blank -%}{%- if child.type == 'collection_link' -%}{%- assign child_img = child.object.image | default: child.object.featured_image -%}{%- endif -%}<span class="nav-mega-img">{% if child_img != blank %}{{ child_img | image_url: width: 480 | image_tag: loading: 'lazy', widths: '240,360,480', sizes: '220px', alt: '' }}{% endif %}</span>{% endif %}<span class="nav-mega-label">{{ child.title | escape }}</span></a>{% endfor %}</div></details>{% else %}<a href="{{ link.url }}">{{ link.title | escape }}</a>{% endif %}
    {% endfor %}{% else %}<a href="{{ routes.all_products_collection_url }}">{{ 'general.shop' | t }}</a><a href="{{ routes.root_url }}#musa-world">{{ 'general.world' | t }}</a><a href="{% if settings.club_page != blank %}{{ settings.club_page.url }}{% else %}{{ routes.root_url }}#musa-club{% endif %}">MUSA Club</a>{% endif %}
  </nav>
  <a class="brand-logo" href="{{ routes.root_url }}" aria-label="{{ shop.name | escape }}"><img class="logo-on-light" src="{{ 'logo-espresso.svg' | asset_url }}" width="140" height="33" alt="MUSA" loading="eager"><img class="logo-on-dark" src="{{ 'logo-ivory.svg' | asset_url }}" width="140" height="33" alt="" loading="eager"></a>
  <div class="header-actions"><div class="header-locale">{% render 'localization', location: 'header' %}</div><a class="icon-button" href="{{ routes.search_url }}" aria-label="{{ 'general.search' | t }}">{% render 'icon', name: 'search' %}</a><a class="bag-link" href="{{ routes.cart_url }}" data-cart-open aria-haspopup="dialog" aria-label="{{ 'general.bag' | t }} ({{ cart.item_count }})">{% render 'icon', name: 'bag' %}<span data-cart-count>{{ cart.item_count }}</span></a></div>
</header>
<nav id="MobileMenu" class="mobile-menu" aria-label="{{ 'general.navigation' | t }}" hidden>
{% if section.settings.menu != blank %}{% for link in section.settings.menu.links %}<a href="{{ link.url }}">{{ link.title | escape }}</a>{% for child in link.links %}<a class="mobile-sub" href="{{ child.url }}">{{ child.title | escape }}</a>{% endfor %}{% endfor %}{% else %}<a href="{{ routes.all_products_collection_url }}">{{ 'general.shop' | t }}</a><a href="{{ routes.root_url }}#musa-world">{{ 'general.world' | t }}</a><a href="{% if settings.club_page != blank %}{{ settings.club_page.url }}{% else %}{{ routes.root_url }}#musa-club{% endif %}">MUSA Club</a>{% endif %}
{% render 'localization', location: 'mobile' %}
</nav>

{% schema %}
{"name": "MUSA Header", "settings": [{"type": "link_list", "id": "menu", "label": "Navigation menu"}]}
{% endschema %}
