{{ 'musa-catalog.css' | asset_url | stylesheet_tag }}
<script src="{{ 'musa-catalog.js' | asset_url }}" defer></script>
<section id="the-edit" class="musa-catalog" data-musa-catalog aria-labelledby="CatalogTitle-{{ section.id }}">
<header class="musa-catalog-intro"><p class="musa-catalog-eyebrow">MUSA — WELCOME TO YOUR NEW ERA</p><h2 id="CatalogTitle-{{ section.id }}">{% if request.locale.iso_code == 'es' %}Tu próxima era, en movimiento.{% else %}Your next era, in motion.{% endif %}</h2><p>{% if request.locale.iso_code == 'es' %}Descubre los modelos de nuestra próxima colección. Los sets se venden completos. Fotografías y precios de venta próximamente.{% else %}Explore the styles in our upcoming collection. Sets are sold complete. Photography and retail pricing coming soon.{% endif %}</p></header>
<div class="musa-catalog-filters" data-catalog-filters hidden role="group" aria-label="{% if request.locale.iso_code == 'es' %}Tipo de producto{% else %}Product type{% endif %}"><button type="button" data-catalog-filter="all" aria-pressed="true">{% if request.locale.iso_code == 'es' %}Todos{% else %}All styles{% endif %}</button><button type="button" data-catalog-filter="sets-2" aria-pressed="false">{% if request.locale.iso_code == 'es' %}Sets de 2 piezas{% else %}2-piece sets{% endif %}</button><button type="button" data-catalog-filter="sets-3" aria-pressed="false">{% if request.locale.iso_code == 'es' %}Sets de 3 piezas{% else %}3-piece sets{% endif %}</button><button type="button" data-catalog-filter="bodysuits" aria-pressed="false">{% if request.locale.iso_code == 'es' %}Enterizos{% else %}Bodysuits{% endif %}</button><button type="button" data-catalog-filter="leggings" aria-pressed="false">{% if request.locale.iso_code == 'es' %}Leggings{% else %}Leggings{% endif %}</button></div>
<p class="musa-catalog-count" role="status" data-catalog-count data-label="{% if request.locale.iso_code == 'es' %}modelos{% else %}styles{% endif %}">15 {% if request.locale.iso_code == 'es' %}modelos{% else %}styles{% endif %}</p>
<div class="musa-catalog-grid">{% render 'catalog-planning-pi-01', section: section %}
{% render 'catalog-planning-pi-02', section: section %}
{% render 'catalog-planning-pi-03', section: section %}
{% render 'catalog-planning-pi-04', section: section %}
{% render 'catalog-planning-pi-05', section: section %}
{% render 'catalog-planning-pi-06', section: section %}
{% render 'catalog-planning-pi-07', section: section %}
{% render 'catalog-planning-pi-08', section: section %}
{% render 'catalog-planning-pi-09', section: section %}
{% render 'catalog-planning-pi-10', section: section %}
{% render 'catalog-planning-pi-11', section: section %}
{% render 'catalog-planning-pi-12', section: section %}
{% render 'catalog-planning-pi-13', section: section %}
{% render 'catalog-planning-pi-14', section: section %}
{% render 'catalog-planning-pi-15', section: section %}</div><p class="musa-catalog-note">{% if request.locale.iso_code == 'es' %}Los nombres de color son descriptivos y se confirmarán con las fotografías finales. Las tallas corresponden al pedido; no indican disponibilidad actual.{% else %}Colour names are descriptive and will be confirmed with final photography. Sizes reflect the order, not current availability.{% endif %}</p>
</section>
{% schema %}
{"name":"MUSA Upcoming collection","settings":[{"type":"image_picker","id":"image_01","label":"Photo — PI-01"},{"type":"image_picker","id":"image_02","label":"Photo — PI-02"},{"type":"image_picker","id":"image_03","label":"Photo — PI-03"},{"type":"image_picker","id":"image_04","label":"Photo — PI-04"},{"type":"image_picker","id":"image_05","label":"Photo — PI-05"},{"type":"image_picker","id":"image_06","label":"Photo — PI-06"},{"type":"image_picker","id":"image_07","label":"Photo — PI-07"},{"type":"image_picker","id":"image_08","label":"Photo — PI-08"},{"type":"image_picker","id":"image_09","label":"Photo — PI-09"},{"type":"image_picker","id":"image_10","label":"Photo — PI-10"},{"type":"image_picker","id":"image_11","label":"Photo — PI-11"},{"type":"image_picker","id":"image_12","label":"Photo — PI-12"},{"type":"image_picker","id":"image_13","label":"Photo — PI-13"},{"type":"image_picker","id":"image_14","label":"Photo — PI-14"},{"type":"image_picker","id":"image_15","label":"Photo — PI-15"}],"presets":[{"name":"MUSA Upcoming collection"}]}
{% endschema %}
