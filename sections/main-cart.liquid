<section class="section-pad cart-page"><div class="page-intro"><p class="eyebrow">{{ 'cart.eyebrow' | t }}</p><h1>{{ 'general.bag' | t }} <span class="muted">({{ cart.item_count }})</span></h1></div>
{% if cart.item_count == 0 %}<div class="empty-state"><p>{{ 'cart.empty' | t }}</p><a class="button" href="{{ routes.all_products_collection_url }}">{{ 'general.shop' | t }} {% render 'icon', name: 'arrow' %}</a></div>{% else %}<form action="{{ routes.cart_url }}" method="post" class="cart-form"><div>{% for item in cart.items %}<article class="cart-item">{% if item.image %}<a href="{{ item.url }}">{{ item.image | image_url: width: 300 | image_tag: loading: 'lazy', width: 120, height: 150 }}</a>{% endif %}<div><a href="{{ item.url }}"><h2>{{ item.product.title | escape }}</h2></a>{% unless item.product.has_only_default_variant %}<p>{{ item.variant.title | escape }}</p>{% endunless %}{% if item.selling_plan_allocation %}<p>{{ item.selling_plan_allocation.selling_plan.name | escape }}</p>{% endif %}{% for property in item.properties %}{% assign first_character = property.first | slice: 0 %}{% if property.last != blank and first_character != '_' %}<p>{{ property.first | escape }}: {% if property.last contains '/uploads/' %}<a href="{{ property.last }}">{{ 'cart.attachment' | t }}</a>{% else %}{{ property.last | escape }}{% endif %}</p>{% endif %}{% endfor %}<p>{{ item.final_price | money }}{% if item.original_price > item.final_price %} <s>{{ item.original_price | money }}</s>{% endif %}</p>{% for discount in item.line_level_discount_allocations %}<p>{{ discount.discount_application.title | escape }} (−{{ discount.amount | money }})</p>{% endfor %}<label for="CartQty-{{ forloop.index }}">{{ 'products.quantity' | t }}</label><input type="number" id="CartQty-{{ forloop.index }}" name="updates[]" min="{{ item.variant.quantity_rule.min }}" step="{{ item.variant.quantity_rule.increment }}" value="{{ item.quantity }}" {% if item.variant.quantity_rule.max %}max="{{ item.variant.quantity_rule.max }}"{% endif %}><a class="remove-link" href="{{ item.url_to_remove }}">{{ 'cart.remove' | t }}</a></div><span>{{ item.final_line_price | money }}</span></article>{% endfor %}<button class="text-link" type="submit" name="update">{{ 'cart.update' | t }}</button></div><aside class="cart-summary"><h2>{{ 'cart.summary' | t }}</h2>{% for discount in cart.cart_level_discount_applications %}<p>{{ discount.title | escape }} −{{ discount.total_allocated_amount | money }}</p>{% endfor %}<div class="subtotal"><span>{{ 'cart.subtotal' | t }}</span><span>{{ cart.total_price | money }}</span></div><p class="small">{{ 'cart.taxes' | t }}</p><label for="CartNote">{{ 'cart.note' | t }}</label><textarea name="note" id="CartNote">{{ cart.note | escape }}</textarea><button class="button" type="submit" name="checkout">{{ 'cart.checkout' | t }} {% render 'icon', name: 'arrow' %}</button></aside></form>{% endif %}</section>

{% schema %}
{"name": "Cart", "settings": []}
{% endschema %}
