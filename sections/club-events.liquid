{{ 'musa-club.css' | asset_url | stylesheet_tag }}
<section class="musa-events section-pad" aria-labelledby="ClubTitle-{{ section.id }}">
  <header class="musa-events-intro"><p class="eyebrow">MUSA CLUB</p><h1 id="ClubTitle-{{ section.id }}">{{ 'events.title' | t }}</h1><p>{{ 'events.intro' | t }}</p></header>
  <div class="musa-events-grid">
  {% assign event_count = 0 %}
  {% for block in section.blocks %}
    {% if block.settings.title_en != blank %}
      {% assign event_count = event_count | plus: 1 %}
      {% assign event_title = block.settings.title_en %}{% assign event_description = block.settings.description_en %}
      {% if request.locale.iso_code == 'es' %}{% assign event_title = block.settings.title_es | default: event_title %}{% assign event_description = block.settings.description_es | default: event_description %}{% endif %}
      <article class="musa-event" {{ block.shopify_attributes }}>
        {% if block.settings.image != blank %}{{ block.settings.image | image_url: width: 1400 | image_tag: loading: 'lazy', widths: '400,700,1000,1400', sizes: '(min-width: 901px) 45vw, 90vw', alt: event_title }}{% endif %}
        <div class="musa-event-copy"><p class="eyebrow">{{ 'events.gathering' | t }}</p><h2>{{ event_title | escape }}</h2>
          {% if block.settings.schedule != blank %}<p><strong>{{ 'events.when' | t }}</strong> {{ block.settings.schedule | escape }}</p>{% endif %}
          {% if block.settings.location != blank %}<p><strong>{{ 'events.where' | t }}</strong> {{ block.settings.location | escape }}</p>{% endif %}
          {% if event_description != blank %}<p>{{ event_description | escape | newline_to_br }}</p>{% endif %}
          {% if block.settings.link != blank %}<a class="text-link" href="{{ block.settings.link }}">{{ 'events.details' | t }} {% render 'icon', name: 'arrow' %}</a>{% endif %}
        </div>
      </article>
    {% endif %}
  {% endfor %}
  {% if event_count == 0 %}<div class="musa-events-empty"><p class="eyebrow">{{ 'events.coming' | t }}</p><h2>{{ 'events.empty_title' | t }}</h2><p>{{ 'events.empty_text' | t }}</p></div>{% endif %}
  </div>
</section>
{% schema %}
{"name":"MUSA Club events","settings":[],"max_blocks":12,"blocks":[{"type":"event","name":"Event","settings":[{"type":"text","id":"title_en","label":"Title — English"},{"type":"text","id":"title_es","label":"Title — Spanish"},{"type":"text","id":"schedule","label":"Date, time and time zone","info":"For example: October 24, 2026 · 10:00 AM CT. Enter the actual event schedule."},{"type":"text","id":"location","label":"Venue / address or online location"},{"type":"image_picker","id":"image","label":"Event photograph"},{"type":"textarea","id":"description_en","label":"Description — English"},{"type":"textarea","id":"description_es","label":"Description — Spanish"},{"type":"url","id":"link","label":"Event details / registration URL"}]}],"presets":[{"name":"MUSA Club events"}]}
{% endschema %}
