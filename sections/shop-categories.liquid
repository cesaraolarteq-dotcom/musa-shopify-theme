{%- comment -%}
  Shop by category. Each tile picks a collection (and optional image). Until collections exist,
  tiles link to the full catalog with the category name typed in the editor.
{%- endcomment -%}
{%- if section.blocks.size > 0 -%}
<section class="shop-cats section-pad" aria-labelledby="ShopCats-{{ section.id }}">
  <div class="section-heading">
    <div><p class="eyebrow">{{ 'categories.eyebrow' | t }}</p><h2 id="ShopCats-{{ section.id }}">{% if section.settings.heading != blank %}{{ section.settings.heading | escape }}{% else %}{{ 'categories.title' | t }} <em>{{ 'categories.emphasis' | t }}</em>{% endif %}</h2></div>
    <a class="text-link" href="{{ routes.all_products_collection_url }}">{{ 'categories.all' | t }} {% render 'icon', name: 'arrow' %}</a>
  </div>
  <div class="shop-cats-grid">
    {%- for block in section.blocks -%}
      {%- assign c = block.settings.collection -%}
      {%- assign tile_image = block.settings.image | default: c.featured_image -%}
      {%- capture tile_title -%}{% if request.locale.iso_code == 'es' and block.settings.title_es != blank %}{{ block.settings.title_es }}{% elsif block.settings.title != blank %}{{ block.settings.title }}{% elsif c != blank %}{{ c.title }}{% endif %}{%- endcapture -%}
      {%- capture tile_url -%}{% if block.settings.link != blank %}{{ block.settings.link }}{% elsif c != blank %}{{ c.url }}{% else %}{{ routes.all_products_collection_url }}{% endif %}{%- endcapture -%}
      <a class="shop-cat{% if tile_image == blank %} shop-cat--art{% endif %}" href="{{ tile_url | strip }}" {{ block.shopify_attributes }}>
        <span class="shop-cat-media">{% if tile_image != blank %}{{ tile_image | image_url: width: 1200 | image_tag: loading: 'lazy', widths: '400,600,900,1200', sizes: '(min-width: 900px) 25vw, 50vw', alt: tile_title }}{% else %}<span class="shop-cat-index" aria-hidden="true">0{{ forloop.index }}</span>{% endif %}</span>
        <span class="shop-cat-label"><span>{{ tile_title | strip | escape }}</span>{% render 'icon', name: 'arrow' %}</span>
      </a>
    {%- endfor -%}
  </div>
</section>
{%- endif -%}

{% schema %}
{"name": "MUSA Shop by category", "settings": [{"type": "text", "id": "heading", "label": "Custom heading (optional)"}], "max_blocks": 6, "blocks": [{"type": "category", "name": "Category", "settings": [{"type": "collection", "id": "collection", "label": "Collection"}, {"type": "text", "id": "title", "label": "Title — English (optional, overrides the collection name)"}, {"type": "text", "id": "title_es", "label": "Title — Spanish (optional)"}, {"type": "image_picker", "id": "image", "label": "Image (optional, overrides the collection image)"}, {"type": "url", "id": "link", "label": "Link (optional)"}]}], "presets": [{"name": "MUSA Shop by category"}]}
{% endschema %}
