{%- comment -%}
  Brand colour story: three tall panels in the MUSA palette (Espresso, Sand, Paper).
  Brand colours only; product colours live in the catalog.
{%- endcomment -%}
<section class="tones" aria-label="{{ 'tones.label' | t }}">
  {%- for n in (1..3) -%}
    {%- capture key %}tones.t{{ n }}{% endcapture -%}
    <div class="tone tone--{{ n }}" data-reveal>
      <svg class="tone-swirl" viewBox="0 0 200 200" aria-hidden="true" focusable="false"><path d="M20 120c30-60 90-70 120-30s10 80-40 70-40-70 20-80 70 40 60 70" fill="none" stroke="currentColor" stroke-width="14" stroke-linecap="round"/></svg>
      <span class="tone-code">{{ 'tones.code' | t }} 0{{ n }}</span>
      <div>
        <h2 class="tone-name">{% if n == 2 %}<em>{{ key | append: '_name' | t }}</em>{% else %}{{ key | append: '_name' | t }}{% endif %}</h2>
        <p>{{ key | append: '_text' | t }}</p>
      </div>
    </div>
  {%- endfor -%}
</section>

{% schema %}
{"name": "MUSA Palette", "settings": [], "presets": [{"name": "MUSA Palette"}]}
{% endschema %}
