<footer class="site-footer"><div class="footer-top"><div><a href="{{ routes.root_url }}"><img src="{{ 'logo-ivory.svg' | asset_url }}" width="230" height="54" alt="MUSA" loading="lazy"></a><p>{{ 'footer.tagline' | t }}</p></div><div class="footer-links"><p class="eyebrow">{{ 'footer.explore' | t }}</p>{% if section.settings.menu != blank %}{% for link in section.settings.menu.links %}<a href="{{ link.url }}">{{ link.title | escape }}</a>{% endfor %}{% else %}<a href="{{ routes.all_products_collection_url }}">{{ 'general.shop' | t }}</a><a href="{{ routes.root_url }}#musa-world">{{ 'general.world' | t }}</a><a href="{{ routes.search_url }}">{{ 'general.search' | t }}</a>{% endif %}</div><div class="footer-links"><p class="eyebrow">{{ 'footer.care' | t }}</p>{% for policy in shop.policies %}{% if policy.body != blank %}<a href="{{ policy.url }}">{{ policy.title | escape }}</a>{% endif %}{% endfor %}{% if section.settings.contact != blank %}<a href="{{ section.settings.contact }}">{{ 'general.contact' | t }}</a>{% endif %}{% if settings.support_email != blank %}<a href="mailto:{{ settings.support_email | escape }}">{{ 'general.contact' | t }}</a>{% endif %}<a href="{% if settings.club_page != blank %}{{ settings.club_page.url }}{% else %}{{ routes.root_url }}#musa-club{% endif %}">MUSA Club</a>{% if shop.customer_accounts_enabled %}<a href="{{ routes.account_url }}">{{ 'general.account' | t }}</a>{% endif %}</div><div class="footer-links"><p class="eyebrow">{{ 'footer.follow' | t }}</p>{% if section.settings.instagram != blank %}<a href="{{ section.settings.instagram }}">Instagram ↗</a>{% endif %}{% render 'localization', location: 'footer' %}</div></div><div class="footer-bottom"><span>© {{ 'now' | date: '%Y' }} {{ shop.name | escape }}</span><span>{{ 'footer.signature' | t }}</span></div></footer>

{% schema %}
{"name": "MUSA Footer", "settings": [{"type": "link_list", "id": "menu", "label": "Footer menu"}, {"type": "url", "id": "contact", "label": "Contact page"}, {"type": "url", "id": "instagram", "label": "Instagram URL"}]}
{% endschema %}
