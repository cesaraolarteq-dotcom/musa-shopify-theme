{%- comment -%}
  Community / Instagram grid without an external widget: the merchant uploads photos (own or
  with permission) and links them. Hidden until at least one image is set.
{%- endcomment -%}
{%- assign shown = 0 -%}{%- for block in section.blocks -%}{%- if block.settings.image != blank -%}{%- assign shown = shown | plus: 1 -%}{%- endif -%}{%- endfor -%}
{%- if shown > 0 -%}
<section class="ig-grid section-pad" aria-labelledby="Ig-{{ section.id }}">
  <div class="section-heading">
    <div><p class="eyebrow">{{ 'community.eyebrow' | t }}</p><h2 id="Ig-{{ section.id }}">{{ 'community.title' | t }} <em>{{ section.settings.handle | default: '@hellomusa.us' | escape }}</em></h2></div>
    {% if section.settings.profile != blank %}<a class="text-link" href="{{ section.settings.profile }}" rel="noopener">{{ 'community.follow' | t }} {% render 'icon', name: 'arrow' %}</a>{% endif %}
  </div>
  <ul class="ig-list">
    {%- for block in section.blocks -%}{%- if block.settings.image != blank -%}
      <li {{ block.shopify_attributes }}>{% if block.settings.link != blank %}<a href="{{ block.settings.link }}" rel="noopener">{% endif %}{{ block.settings.image | image_url: width: 800 | image_tag: loading: 'lazy', widths: '300,500,800', sizes: '(min-width: 900px) 17vw, 33vw', alt: block.settings.alt | default: 'MUSA community' }}{% if block.settings.link != blank %}</a>{% endif %}</li>
    {%- endif -%}{%- endfor -%}
  </ul>
</section>
{%- endif -%}

{% schema %}
{"name": "MUSA Community grid", "settings": [{"type": "text", "id": "handle", "label": "Handle", "default": "@hellomusa.us"}, {"type": "url", "id": "profile", "label": "Instagram profile URL"}], "max_blocks": 12, "blocks": [{"type": "photo", "name": "Photo", "settings": [{"type": "image_picker", "id": "image", "label": "Photo", "info": "Use your own photos or ones you have permission to share."}, {"type": "text", "id": "alt", "label": "Image description"}, {"type": "url", "id": "link", "label": "Post link (optional)"}]}], "presets": [{"name": "MUSA Community grid"}]}
{% endschema %}
