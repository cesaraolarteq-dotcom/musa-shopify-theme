{%- comment -%}
  Store promises (shipping, returns, secure checkout…). Text is entered by the merchant;
  nothing renders until a block has text, so no policy is ever implied by the theme.
{%- endcomment -%}
{%- assign has_text = false -%}{%- for block in section.blocks -%}{%- if block.settings.text != blank -%}{%- assign has_text = true -%}{%- endif -%}{%- endfor -%}
{%- if has_text -%}
<div class="benefits-bar" role="region" aria-label="{{ 'benefits.label' | t }}">
  <ul class="benefits-list">
    {%- for block in section.blocks -%}{%- if block.settings.text != blank -%}
      <li {{ block.shopify_attributes }}>{% render 'icon', name: block.settings.icon %}{% if block.settings.link != blank %}<a href="{{ block.settings.link }}">{{ block.settings.text | escape }}</a>{% else %}<span>{{ block.settings.text | escape }}</span>{% endif %}</li>
    {%- endif -%}{%- endfor -%}
  </ul>
</div>
{%- endif -%}

{% schema %}
{"name": "MUSA Benefits bar", "max_blocks": 4, "blocks": [{"type": "benefit", "name": "Benefit", "settings": [{"type": "select", "id": "icon", "label": "Icon", "options": [{"value": "truck", "label": "Shipping"}, {"value": "return", "label": "Returns"}, {"value": "lock", "label": "Secure checkout"}, {"value": "bag", "label": "Bag"}], "default": "truck"}, {"type": "text", "id": "text", "label": "Text", "info": "Only state what your published policies actually offer."}, {"type": "url", "id": "link", "label": "Link (optional)"}]}], "presets": [{"name": "MUSA Benefits bar"}]}
{% endschema %}
