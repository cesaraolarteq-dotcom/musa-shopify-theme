{%- comment -%}
  Slide-out bag. Rendered statically from layout/theme.liquid and re-rendered through the
  Section Rendering API (sections=cart-drawer) after add / change requests in assets/musa.js.
{%- endcomment -%}
<div class="cart-drawer" id="CartDrawer" data-cart-drawer data-count="{{ cart.item_count }}" hidden>
  <div class="drawer-overlay" data-drawer-close></div>
  <div class="drawer-panel" role="dialog" aria-modal="true" aria-labelledby="CartDrawerTitle" tabindex="-1">
    <div class="drawer-head">
      <h2 id="CartDrawerTitle">{{ 'cart.drawer_title' | t }} <span class="drawer-count">({{ cart.item_count }})</span></h2>
      <button type="button" class="icon-button" data-drawer-close aria-label="{{ 'general.close' | t }}">{% render 'icon', name: 'close' %}</button>
    </div>
    {%- assign threshold = settings.free_shipping_threshold | times: 100 -%}
    {%- if threshold > 0 and cart.item_count > 0 -%}
      {%- assign remaining = threshold | minus: cart.total_price -%}
      {%- assign progress = cart.total_price | times: 100 | divided_by: threshold -%}{%- if progress > 100 -%}{%- assign progress = 100 -%}{%- endif -%}
      <div class="free-ship" style="--progress: {{ progress }}%">
        <p>{% render 'icon', name: 'truck' %}{% if remaining > 0 %}{%- assign remaining_money = remaining | money -%}{{ 'cart.free_shipping_remaining' | t: amount: remaining_money }}{% else %}{{ 'cart.free_shipping_unlocked' | t }}{% endif %}</p>
        <div class="free-ship-bar" aria-hidden="true"><span></span></div>
      </div>
    {%- endif -%}
    <p class="drawer-error" role="alert" data-drawer-error hidden></p>
    <div class="drawer-body">
      {%- if cart.item_count == 0 -%}
        <div class="drawer-empty"><p class="drawer-empty-title">{{ 'cart.empty' | t }}</p><a class="button" href="{{ routes.all_products_collection_url }}">{{ 'general.shop' | t }} {% render 'icon', name: 'arrow' %}</a></div>
      {%- else -%}
        <ul class="drawer-items">
          {%- for item in cart.items -%}
            <li class="drawer-item" data-line="{{ forloop.index }}">
              <a class="drawer-item-media" href="{{ item.url }}" tabindex="-1">{% if item.image %}{{ item.image | image_url: width: 240 | image_tag: loading: 'lazy', width: 96, height: 120, alt: item.product.title }}{% endif %}</a>
              <div class="drawer-item-info">
                <a href="{{ item.url }}" class="drawer-item-title">{{ item.product.title | escape }}</a>
                {%- unless item.product.has_only_default_variant -%}<p class="drawer-item-variant">{{ item.variant.title | escape }}</p>{%- endunless -%}
                {%- for discount in item.line_level_discount_allocations -%}<p class="drawer-item-variant">{{ discount.discount_application.title | escape }} (−{{ discount.amount | money }})</p>{%- endfor -%}
                <div class="drawer-item-actions">
                  <div class="qty-stepper qty-stepper--small">
                    <button type="button" class="qty-btn" data-cart-change="{{ item.quantity | minus: item.variant.quantity_rule.increment }}" aria-label="{{ 'products.decrease' | t }}: {{ item.product.title | escape }}">{% render 'icon', name: 'minus' %}</button>
                    <span class="qty-value" aria-live="polite">{{ item.quantity }}</span>
                    <button type="button" class="qty-btn" data-cart-change="{{ item.quantity | plus: item.variant.quantity_rule.increment }}" aria-label="{{ 'products.increase' | t }}: {{ item.product.title | escape }}" {% if item.variant.quantity_rule.max and item.quantity >= item.variant.quantity_rule.max %}disabled{% endif %}>{% render 'icon', name: 'plus' %}</button>
                  </div>
                  <button type="button" class="drawer-remove" data-cart-change="0">{{ 'cart.remove' | t }}</button>
                </div>
              </div>
              <div class="drawer-item-price">{{ item.final_line_price | money }}{% if item.original_line_price > item.final_line_price %}<s>{{ item.original_line_price | money }}</s>{% endif %}</div>
            </li>
          {%- endfor -%}
        </ul>
      {%- endif -%}
    </div>
    {%- if cart.item_count > 0 -%}
      <div class="drawer-foot">
        {%- for discount in cart.cart_level_discount_applications -%}<p class="drawer-discount">{{ discount.title | escape }} <span>−{{ discount.total_allocated_amount | money }}</span></p>{%- endfor -%}
        <div class="subtotal"><span>{{ 'cart.subtotal' | t }}</span><span>{{ cart.total_price | money }}</span></div>
        <p class="small">{{ 'cart.taxes' | t }}</p>
        <form action="{{ routes.cart_url }}" method="post"><button class="button drawer-checkout" type="submit" name="checkout">{{ 'cart.checkout' | t }} {% render 'icon', name: 'arrow' %}</button></form>
        <a class="text-link drawer-view" href="{{ routes.cart_url }}">{{ 'cart.view_bag' | t }}</a>
      </div>
    {%- endif -%}
  </div>
</div>

{% schema %}
{"name": "Cart drawer", "settings": []}
{% endschema %}
