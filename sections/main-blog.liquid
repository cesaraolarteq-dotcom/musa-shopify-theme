<section class="section-pad"><div class="page-intro"><p class="eyebrow">MUSA / JOURNAL</p><h1>{{ blog.title | escape }}</h1></div>{% paginate blog.articles by 9 %}<div class="collection-grid">{% for article in blog.articles %}<article>{% if article.image %}<a href="{{ article.url }}">{{ article.image | image_url: width: 1000 | image_tag: loading: 'lazy', widths: '400,700,1000', sizes: '(min-width: 900px) 33vw, 100vw' }}</a>{% endif %}<p class="eyebrow">{{ article.published_at | date: '%d.%m.%Y' }}</p><h2><a href="{{ article.url }}">{{ article.title | escape }}</a></h2><p>{{ article.excerpt_or_content | strip_html | truncate: 180 }}</p></article>{% endfor %}</div>{% render 'pagination', paginate: paginate %}{% endpaginate %}</section>

{% schema %}
{"name": "Journal", "settings": []}
{% endschema %}
