<section class="launch-page section-pad"><img src="{{ 'logo-espresso.svg' | asset_url }}" width="190" height="45" alt="MUSA"><p class="eyebrow">{{ 'brand.edition' | t }}</p><h1>{{ 'password.title' | t }}</h1><p>{{ shop.password_message | escape }}</p>{% form 'storefront_password' %}{{ form.errors | default_errors }}<label for="Password">{{ 'password.label' | t }}</label><input id="Password" type="password" name="password" autocomplete="current-password" required><button class="button" type="submit">{{ 'password.enter' | t }}</button>{% endform %}</section>

{% schema %}
{"name": "Launch", "settings": []}
{% endschema %}
