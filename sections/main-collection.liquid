<section class="section-pad collection-page"><div class="page-intro"><p class="eyebrow">{{ 'brand.edition' | t }}</p><h1>{{ collection.title | escape }}</h1>{% if collection.description != blank %}<div class="rte">{{ collection.description }}</div>{% endif %}</div>
<form class="collection-controls" method="get"><div class="filters">{% for filter in collection.filters %}<details><summary>{{ filter.label | escape }}</summary><div class="filter-panel">{% case filter.type %}{% when 'list', 'boolean' %}{% for value in filter.values %}<label class="filter-choice"><input type="checkbox" name="{{ value.param_name }}" value="{{ value.value | escape }}" {% if value.active %}checked{% endif %} {% if value.count == 0 and value.active == false %}disabled{% endif %}>{{ value.label | escape }} ({{ value.count }})</label>{% endfor %}{% when 'price_range' %}<label>{{ 'products.min_price' | t }}<input type="number" name="{{ filter.min_value.param_name }}" min="0" step="0.01" {% if filter.min_value.value %}value="{{ filter.min_value.value | divided_by: 100.0 }}"{% endif %}></label><label>{{ 'products.max_price' | t }}<input type="number" name="{{ filter.max_value.param_name }}" min="0" step="0.01" {% if filter.max_value.value %}value="{{ filter.max_value.value | divided_by: 100.0 }}"{% endif %}></label>{% endcase %}</div></details>{% endfor %}</div><div class="sort-controls"><label for="SortBy">{{ 'products.sort' | t }}</label><select name="sort_by" id="SortBy">{% assign sort_by = collection.sort_by | default: collection.default_sort_by %}{% for option in collection.sort_options %}<option value="{{ option.value }}" {% if sort_by == option.value %}selected{% endif %}>{{ option.name }}</option>{% endfor %}</select><button class="text-link" type="submit">{{ 'general.apply' | t }}</button></div></form>
<div class="active-filters">{% for filter in collection.filters %}{% for value in filter.active_values %}<a href="{{ value.url_to_remove }}">{{ value.label | escape }} ×</a>{% endfor %}{% if filter.type == 'price_range' %}{% if filter.min_value.value != nil or filter.max_value.value != nil %}<a href="{{ filter.url_to_remove }}">{{ filter.label | escape }} ×</a>{% endif %}{% endif %}{% endfor %}<a href="{{ collection.url }}">{{ 'products.reset' | t }}</a></div>
{% paginate collection.products by 16 %}<div class="product-grid">{% for product in collection.products %}{% render 'product-card', product: product %}{% else %}{% if collection.all_products_count == 0 and section.settings.show_demo %}{% for i in (1..4) %}{% render 'demo-card', index: i %}{% endfor %}{% else %}<p>{{ 'products.empty' | t }}</p>{% endif %}{% endfor %}</div>{% if collection.all_products_count == 0 and section.settings.show_demo %}<p class="demo-disclaimer">{{ 'demo.disclaimer' | t }}</p>{% endif %}{% render 'pagination', paginate: paginate %}{% endpaginate %}</section>

{% schema %}
{"name": "Collection", "settings": [{"type": "checkbox", "id": "show_demo", "label": "Show concept garments when empty", "default": true}]}
{% endschema %}
