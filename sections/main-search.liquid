<section class="section-pad"><div class="page-intro"><p class="eyebrow">MUSA / {{ 'general.search' | t }}</p><h1>{{ 'search.title' | t }}</h1><form action="{{ routes.search_url }}" method="get" class="search-form"><label class="visually-hidden" for="Search">{{ 'general.search' | t }}</label><input type="search" name="q" id="Search" value="{{ search.terms | escape }}" placeholder="{{ 'search.placeholder' | t }}"><button type="submit" class="button">{{ 'general.search' | t }}</button></form></div>{% if search.performed %}{% paginate search.results by 16 %}<p>{{ 'search.results' | t: count: search.results_count }}</p><div class="product-grid">{% for result in search.results %}{% if result.object_type == 'product' %}{% render 'product-card', product: result %}{% else %}<article class="search-content-card"><p class="eyebrow">{{ result.object_type | escape }}</p><a href="{{ result.url }}"><h2>{{ result.title | escape }}</h2></a><p>{{ result.content | strip_html | truncate: 160 }}</p></article>{% endif %}{% else %}<p>{{ 'search.empty' | t }}</p>{% endfor %}</div>{% render 'pagination', paginate: paginate %}{% endpaginate %}{% endif %}</section>

{% schema %}
{"name": "Search", "settings": []}
{% endschema %}
