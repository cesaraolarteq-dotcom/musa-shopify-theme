<article class="musa-catalog-card" data-catalog-card data-category="sets-3" data-reference="PI-01">
<div class="musa-catalog-art{% if section.settings.image_01 or section.settings.reference_photos != false %} musa-catalog-art--photo{% endif %}">{% if section.settings.image_01 %}{% capture catalog_image_alt %}{% if request.locale.iso_code == 'es' %}Set de top, pantalón y manga larga{% else %}Tank, pants &amp; long-sleeve set{% endif %}{% endcapture %}{{ section.settings.image_01 | image_url: width: 1200 | image_tag: loading: 'lazy', widths: '400,600,900,1200', sizes: '(min-width: 901px) 33vw, (min-width: 551px) 50vw, 100vw', alt: catalog_image_alt }}{% elsif section.settings.reference_photos != false %}<img src="{{ 'catalog-reference-pi-01.jpg' | asset_url }}" width="160" height="342" loading="lazy" alt="{% if request.locale.iso_code == 'es' %}Set de top, pantalón y manga larga{% else %}Tank, pants &amp; long-sleeve set{% endif %} — {% if request.locale.iso_code == 'es' %}referencia del proveedor{% else %}supplier reference{% endif %}"><span class="musa-reference-label">{% if request.locale.iso_code == 'es' %}Referencia · color ilustrativo{% else %}Reference · illustrative color{% endif %}</span>{% else %}<span class="musa-catalog-number" aria-hidden="true">01</span><span class="musa-catalog-type">{% if request.locale.iso_code == 'es' %}Sets de 3 piezas{% else %}3-piece sets{% endif %}</span><span class="musa-catalog-photo">{% if request.locale.iso_code == 'es' %}Fotografía próximamente{% else %}Photography coming soon{% endif %}</span>{% endif %}</div>
<div class="musa-catalog-card-body"><p class="musa-catalog-ref">{% if request.locale.iso_code == 'es' %}Referencia{% else %}Reference{% endif %} PI-01</p><h3>{% if request.locale.iso_code == 'es' %}Set de top, pantalón y manga larga{% else %}Tank, pants &amp; long-sleeve set{% endif %}</h3><p class="musa-catalog-unit">{% if request.locale.iso_code == 'es' %}Sets de 3 piezas{% else %}3-piece sets{% endif %} / {% if request.locale.iso_code == 'es' %}Próximamente{% else %}Coming soon{% endif %}</p>
<div data-catalog-color-control hidden><label for="CatalogColor-{{ section.id }}-PI-01">{% if request.locale.iso_code == 'es' %}Color{% else %}Color{% endif %}</label><select id="CatalogColor-{{ section.id }}-PI-01" data-catalog-color><option value="0" data-sizes="S · M · L · XL">{% if request.locale.iso_code == 'es' %}Azul con azul claro{% else %}Blue with light blue{% endif %}</option></select><p class="musa-catalog-sizes">{% if request.locale.iso_code == 'es' %}Tallas previstas{% else %}Planned sizes{% endif %}: <span data-catalog-sizes aria-live="polite">S · M · L · XL</span></p></div>
<details data-catalog-matrix><summary>{% if request.locale.iso_code == 'es' %}Ver colores y tallas{% else %}View colors and sizes{% endif %}</summary><ul><li><span>{% if request.locale.iso_code == 'es' %}Azul con azul claro{% else %}Blue with light blue{% endif %}</span><span>S · M · L · XL</span></li></ul></details></div></article>
