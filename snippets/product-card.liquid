<article class="product-card"><a href="{{ product.url }}" class="product-card-image">
{% if product.featured_image %}{{ product.featured_image | image_url: width: 900 | image_tag: loading: 'lazy', widths: '300,450,600,900', sizes: '(min-width: 900px) 25vw, 50vw' }}{% if product.images[1] %}{{ product.images[1] | image_url: width: 900 | image_tag: loading: 'lazy', widths: '300,450,600,900', sizes: '(min-width: 900px) 25vw, 50vw', class: 'product-secondary' }}{% endif %}{% else %}{{ 'product-1' | placeholder_svg_tag: 'placeholder-svg' }}{% endif %}
{% unless product.available %}<span class="product-badge">{{ 'products.sold_out' | t }}</span>{% endunless %}<span class="card-arrow">{% render 'icon', name: 'arrow' %}</span></a>
<div class="product-card-info"><div><a href="{{ product.url }}"><h3>{{ product.title | escape }}</h3></a><span class="product-type">{{ product.type | escape }}</span></div><span class="card-price">{% if product.price_varies %}{{ 'products.from' | t }} {% endif %}{{ product.price | money }}{% if product.compare_at_price > product.price %}<s>{{ product.compare_at_price | money }}</s>{% endif %}</span></div></article>
