<article class="product-card"><div class="product-card-media"><a href="{{ product.url }}" class="product-card-image">
{% if product.featured_image %}{{ product.featured_image | image_url: width: 900 | image_tag: loading: 'lazy', widths: '300,450,600,900', sizes: '(min-width: 900px) 25vw, 50vw' }}{% if product.images[1] %}{{ product.images[1] | image_url: width: 900 | image_tag: loading: 'lazy', widths: '300,450,600,900', sizes: '(min-width: 900px) 25vw, 50vw', class: 'product-secondary' }}{% endif %}{% else %}{{ 'product-1' | placeholder_svg_tag: 'placeholder-svg' }}{% endif %}
{%- assign tags_down = product.tags | join: ',' | downcase | split: ',' -%}<span class="product-badges">{% unless product.available %}<span class="product-badge">{{ 'products.sold_out' | t }}</span>{% else %}{% if tags_down contains 'new' or tags_down contains 'nuevo' %}<span class="product-badge product-badge--new">{{ 'products.new' | t }}</span>{% endif %}{% endunless %}</span><span class="card-arrow">{% render 'icon', name: 'arrow' %}</span></a>
<button type="button" class="quick-view" data-quick-view="{{ product.url | split: '?' | first }}?view=quick" aria-label="{{ 'products.quick_view' | t }}: {{ product.title | escape }}">{% render 'icon', name: 'eye' %}<span>{{ 'products.quick_view' | t }}</span></button></div>
<div class="product-card-info"><div><a href="{{ product.url }}"><h3>{{ product.title | escape }}</h3></a><span class="product-type">{{ product.type | escape }}</span>{%- for option in product.options_with_values -%}{%- assign oname = option.name | downcase -%}{%- if oname contains 'color' or oname contains 'colour' -%}{%- if option.values.size > 1 -%}<span class="card-colors" aria-label="{{ 'products.colors_count' | t: count: option.values.size }}">{%- for value in option.values limit: 5 -%}{%- capture swatch_bg -%}{% if value.swatch.color %}{{ value.swatch.color }}{% else %}{% render 'swatch-color', name: value.name %}{% endif %}{%- endcapture -%}<i style="--swatch: {{ swatch_bg | strip }}"></i>{%- endfor -%}{%- if option.values.size > 5 -%}<small>+{{ option.values.size | minus: 5 }}</small>{%- endif -%}</span>{%- endif -%}{%- endif -%}{%- endfor -%}</div><span class="card-price">{% if product.price_varies %}{{ 'products.from' | t }} {% endif %}{{ product.price | money }}{% if product.compare_at_price > product.price %}<s>{{ product.compare_at_price | money }}</s>{% endif %}</span></div></article>
