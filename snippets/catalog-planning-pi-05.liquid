<article class="musa-catalog-card" data-catalog-card data-category="sets-3" data-reference="PI-05">
<div class="musa-catalog-art{% if section.settings.image_05 %} musa-catalog-art--photo{% endif %}">{% if section.settings.image_05 %}{% capture catalog_image_alt %}{% if request.locale.iso_code == 'es' %}Set de chaqueta, top y leggings{% else %}Jacket, tank &amp; leggings set{% endif %}{% endcapture %}{{ section.settings.image_05 | image_url: width: 1200 | image_tag: loading: 'lazy', widths: '400,600,900,1200', sizes: '(min-width: 901px) 33vw, (min-width: 551px) 50vw, 100vw', alt: catalog_image_alt }}{% else %}<span class="musa-catalog-number" aria-hidden="true">05</span><span class="musa-catalog-type">{% if request.locale.iso_code == 'es' %}Sets de 3 piezas{% else %}3-piece sets{% endif %}</span><span class="musa-catalog-photo">{% if request.locale.iso_code == 'es' %}Fotografía próximamente{% else %}Photography coming soon{% endif %}</span>{% endif %}</div>
<div class="musa-catalog-card-body"><p class="musa-catalog-ref">{% if request.locale.iso_code == 'es' %}Referencia{% else %}Reference{% endif %} PI-05</p><h3>{% if request.locale.iso_code == 'es' %}Set de chaqueta, top y leggings{% else %}Jacket, tank &amp; leggings set{% endif %}</h3><p class="musa-catalog-unit">{% if request.locale.iso_code == 'es' %}Sets de 3 piezas{% else %}3-piece sets{% endif %} / {% if request.locale.iso_code == 'es' %}Próximamente{% else %}Coming soon{% endif %}</p>
<div data-catalog-color-control hidden><label for="CatalogColor-{{ section.id }}-PI-05">{% if request.locale.iso_code == 'es' %}Color{% else %}Colour{% endif %}</label><select id="CatalogColor-{{ section.id }}-PI-05" data-catalog-color><option value="0" data-sizes="S · M · L">{% if request.locale.iso_code == 'es' %}Azul profundo{% else %}Deep blue{% endif %}</option><option value="1" data-sizes="S · M · L">{% if request.locale.iso_code == 'es' %}Rosa fresa{% else %}Strawberry pink{% endif %}</option><option value="2" data-sizes="S · M · L">{% if request.locale.iso_code == 'es' %}Negro{% else %}Black{% endif %}</option><option value="3" data-sizes="S · M · L">{% if request.locale.iso_code == 'es' %}Amarillo marfil{% else %}Ivory yellow{% endif %}</option></select><p class="musa-catalog-sizes">{% if request.locale.iso_code == 'es' %}Tallas previstas{% else %}Planned sizes{% endif %}: <span data-catalog-sizes aria-live="polite">S · M · L</span></p></div>
<details data-catalog-matrix><summary>{% if request.locale.iso_code == 'es' %}Ver colores y tallas{% else %}View colours and sizes{% endif %}</summary><ul><li><span>{% if request.locale.iso_code == 'es' %}Azul profundo{% else %}Deep blue{% endif %}</span><span>S · M · L</span></li><li><span>{% if request.locale.iso_code == 'es' %}Rosa fresa{% else %}Strawberry pink{% endif %}</span><span>S · M · L</span></li><li><span>{% if request.locale.iso_code == 'es' %}Negro{% else %}Black{% endif %}</span><span>S · M · L</span></li><li><span>{% if request.locale.iso_code == 'es' %}Amarillo marfil{% else %}Ivory yellow{% endif %}</span><span>S · M · L</span></li></ul></details></div></article>
