<article class="musa-catalog-card" data-catalog-card data-category="sets-2" data-reference="PI-09">
<div class="musa-catalog-art{% if section.settings.image_09 or section.settings.reference_photos != false %} musa-catalog-art--photo{% endif %}">{% if section.settings.image_09 %}{% capture catalog_image_alt %}{% if request.locale.iso_code == 'es' %}Set de bra y short{% else %}Bra &amp; shorts set{% endif %}{% endcapture %}{{ section.settings.image_09 | image_url: width: 1200 | image_tag: loading: 'lazy', widths: '400,600,900,1200', sizes: '(min-width: 901px) 33vw, (min-width: 551px) 50vw, 100vw', alt: catalog_image_alt }}{% elsif section.settings.reference_photos != false %}<img src="{{ 'catalog-reference-pi-09.jpg' | asset_url }}" width="194" height="283" loading="lazy" alt="{% if request.locale.iso_code == 'es' %}Set de bra y short{% else %}Bra &amp; shorts set{% endif %} — {% if request.locale.iso_code == 'es' %}referencia del proveedor{% else %}supplier reference{% endif %}"><span class="musa-reference-label">{% if request.locale.iso_code == 'es' %}Referencia · color ilustrativo{% else %}Reference · illustrative color{% endif %}</span>{% else %}<span class="musa-catalog-number" aria-hidden="true">09</span><span class="musa-catalog-type">{% if request.locale.iso_code == 'es' %}Sets de 2 piezas{% else %}2-piece sets{% endif %}</span><span class="musa-catalog-photo">{% if request.locale.iso_code == 'es' %}Fotografía próximamente{% else %}Photography coming soon{% endif %}</span>{% endif %}</div>
<div class="musa-catalog-card-body"><p class="musa-catalog-ref">{% if request.locale.iso_code == 'es' %}Referencia{% else %}Reference{% endif %} PI-09</p><h3>{% if request.locale.iso_code == 'es' %}Set de bra y short{% else %}Bra &amp; shorts set{% endif %}</h3><p class="musa-catalog-unit">{% if request.locale.iso_code == 'es' %}Sets de 2 piezas{% else %}2-piece sets{% endif %} / {% if request.locale.iso_code == 'es' %}Próximamente{% else %}Coming soon{% endif %}</p>
<div data-catalog-color-control hidden><label for="CatalogColor-{{ section.id }}-PI-09">{% if request.locale.iso_code == 'es' %}Color{% else %}Color{% endif %}</label><select id="CatalogColor-{{ section.id }}-PI-09" data-catalog-color><option value="0" data-sizes="S · M · L">{% if request.locale.iso_code == 'es' %}Morado{% else %}Purple{% endif %}</option><option value="1" data-sizes="S · M · L">{% if request.locale.iso_code == 'es' %}Negro{% else %}Black{% endif %}</option><option value="2" data-sizes="S · M · L">{% if request.locale.iso_code == 'es' %}Naranja{% else %}Orange{% endif %}</option></select><p class="musa-catalog-sizes">{% if request.locale.iso_code == 'es' %}Tallas previstas{% else %}Planned sizes{% endif %}: <span data-catalog-sizes aria-live="polite">S · M · L</span></p></div>
