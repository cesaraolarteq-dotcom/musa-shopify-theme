<article class="musa-catalog-card" data-catalog-card data-category="sets-3" data-reference="PI-03">
<div class="musa-catalog-art{% if section.settings.image_03 or section.settings.reference_photos != false %} musa-catalog-art--photo{% endif %}">{% if section.settings.image_03 %}{% capture catalog_image_alt %}{% if request.locale.iso_code == 'es' %}Set de chaqueta, bra y leggings{% else %}Jacket, bra &amp; leggings set{% endif %}{% endcapture %}{{ section.settings.image_03 | image_url: width: 1200 | image_tag: loading: 'lazy', widths: '400,600,900,1200', sizes: '(min-width: 901px) 33vw, (min-width: 551px) 50vw, 100vw', alt: catalog_image_alt }}{% elsif section.settings.reference_photos != false %}<img src="{{ 'catalog-reference-pi-03.jpg' | asset_url }}" width="232" height="417" loading="lazy" alt="{% if request.locale.iso_code == 'es' %}Set de chaqueta, bra y leggings{% else %}Jacket, bra &amp; leggings set{% endif %} — {% if request.locale.iso_code == 'es' %}referencia del proveedor{% else %}supplier reference{% endif %}"><span class="musa-reference-label">{% if request.locale.iso_code == 'es' %}Referencia · color ilustrativo{% else %}Reference · illustrative color{% endif %}</span>{% else %}<span class="musa-catalog-number" aria-hidden="true">03</span><span class="musa-catalog-type">{% if request.locale.iso_code == 'es' %}Sets de 3 piezas{% else %}3-piece sets{% endif %}</span><span class="musa-catalog-photo">{% if request.locale.iso_code == 'es' %}Fotografía próximamente{% else %}Photography coming soon{% endif %}</span>{% endif %}</div>
<div class="musa-catalog-card-body"><p class="musa-catalog-ref">{% if request.locale.iso_code == 'es' %}Referencia{% else %}Reference{% endif %} PI-03</p><h3>{% if request.locale.iso_code == 'es' %}Set de chaqueta, bra y leggings{% else %}Jacket, bra &amp; leggings set{% endif %}</h3><p class="musa-catalog-unit">{% if request.locale.iso_code == 'es' %}Sets de 3 piezas{% else %}3-piece sets{% endif %} / {% if request.locale.iso_code == 'es' %}Próximamente{% else %}Coming soon{% endif %}</p>
<div data-catalog-color-control hidden><label for="CatalogColor-{{ section.id }}-PI-03">{% if request.locale.iso_code == 'es' %}Color{% else %}Color{% endif %}</label><select id="CatalogColor-{{ section.id }}-PI-03" data-catalog-color><option value="0" data-sizes="S · M · L">{% if request.locale.iso_code == 'es' %}Azul profundo{% else %}Deep blue{% endif %}</option><option value="1" data-sizes="S · M · L">{% if request.locale.iso_code == 'es' %}Rosa fresa{% else %}Strawberry pink{% endif %}</option><option value="2" data-sizes="S · M · L">{% if request.locale.iso_code == 'es' %}Marrón oscuro con amarillo{% else %}Dark brown with yellow{% endif %}</option></select><p class="musa-catalog-sizes">{% if request.locale.iso_code == 'es' %}Tallas previstas{% else %}Planned sizes{% endif %}: <span data-catalog-sizes aria-live="polite">S · M · L</span></p></div>
<details data-catalog-matrix><summary>{% if request.locale.iso_code == 'es' %}Ver colores y tallas{% else %}View colors and sizes{% endif %}</summary><ul><li><span>{% if request.locale.iso_code == 'es' %}Azul profundo{% else %}Deep blue{% endif %}</span><span>S · M · L</span></li><li><span>{% if request.locale.iso_code == 'es' %}Rosa fresa{% else %}Strawberry pink{% endif %}</span><span>S · M · L</span></li><li><span>{% if request.locale.iso_code == 'es' %}Marrón oscuro con amarillo{% else %}Dark brown with yellow{% endif %}</span><span>S · M · L</span></li></ul></details></div></article>
