<article class="musa-catalog-card" data-catalog-card data-category="sets-2" data-reference="PI-10">
<div class="musa-catalog-art{% if section.settings.image_10 %} musa-catalog-art--photo{% endif %}">{% if section.settings.image_10 %}{% capture catalog_image_alt %}{% if request.locale.iso_code == 'es' %}Set de bra y pantalón{% else %}Bra &amp; pants set{% endif %}{% endcapture %}{{ section.settings.image_10 | image_url: width: 1200 | image_tag: loading: 'lazy', widths: '400,600,900,1200', sizes: '(min-width: 901px) 33vw, (min-width: 551px) 50vw, 100vw', alt: catalog_image_alt }}{% else %}<span class="musa-catalog-number" aria-hidden="true">10</span><span class="musa-catalog-type">{% if request.locale.iso_code == 'es' %}Sets de 2 piezas{% else %}2-piece sets{% endif %}</span><span class="musa-catalog-photo">{% if request.locale.iso_code == 'es' %}Fotografía próximamente{% else %}Photography coming soon{% endif %}</span>{% endif %}</div>
<div class="musa-catalog-card-body"><p class="musa-catalog-ref">{% if request.locale.iso_code == 'es' %}Referencia{% else %}Reference{% endif %} PI-10</p><h3>{% if request.locale.iso_code == 'es' %}Set de bra y pantalón{% else %}Bra &amp; pants set{% endif %}</h3><p class="musa-catalog-unit">{% if request.locale.iso_code == 'es' %}Sets de 2 piezas{% else %}2-piece sets{% endif %} / {% if request.locale.iso_code == 'es' %}Próximamente{% else %}Coming soon{% endif %}</p>
<div data-catalog-color-control hidden><label for="CatalogColor-{{ section.id }}-PI-10">{% if request.locale.iso_code == 'es' %}Color{% else %}Colour{% endif %}</label><select id="CatalogColor-{{ section.id }}-PI-10" data-catalog-color><option value="0" data-sizes="S · M · L">{% if request.locale.iso_code == 'es' %}Blanco{% else %}White{% endif %}</option></select><p class="musa-catalog-sizes">{% if request.locale.iso_code == 'es' %}Tallas previstas{% else %}Planned sizes{% endif %}: <span data-catalog-sizes aria-live="polite">S · M · L</span></p></div>
<details data-catalog-matrix><summary>{% if request.locale.iso_code == 'es' %}Ver colores y tallas{% else %}View colours and sizes{% endif %}</summary><ul><li><span>{% if request.locale.iso_code == 'es' %}Blanco{% else %}White{% endif %}</span><span>S · M · L</span></li></ul></details></div></article>
